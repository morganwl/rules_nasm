load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_nasm//nasm:defs.bzl", "nasm_cc_binary", "nasm_cc_library", "nasm_cc_test")

nasm_cc_test(
    name = "nasm_test_test",
    size = "small",
    srcs = select({
        "//platforms:macho64_constraint": ["always_succeed_main_mac.asm"],
        "//conditions:default": ["always_succeed_main.asm"],
    }),
    target_compatible_with = select({
        "@platforms//cpu:aarch64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "nasm_component_test",
    size = "small",
    srcs = ["nasm_component_test.c"],
    target_compatible_with = select({
        "@platforms//cpu:aarch64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":nasm_component"],
)

nasm_cc_library(
    name = "nasm_component",
    srcs = select({
        "@platforms//os:macos": ["nasm_component_test_mac.asm"],
        "//conditions:default": ["nasm_component_test.asm"],
    }),
    target_compatible_with = select({
        "@platforms//cpu:aarch64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

native_test(
    name = "nasm_binary_test",
    size = "small",
    src = select({
        "@platforms//os:macos": ":nasm_executable_mac",
        "//conditions:default": ":nasm_executable",
    }),
    target_compatible_with = select({
        "@platforms//cpu:aarch64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

nasm_cc_binary(
    name = "nasm_executable",
    srcs = ["always_succeed_main.asm"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

nasm_cc_binary(
    name = "nasm_executable_mac",
    srcs = ["always_succeed_main_mac.asm"],
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

nasm_cc_test(
    name = "includes_test",
    size = "small",
    srcs = ["includes_main.asm"],
    hdrs = [
        "includes_inc.asm",
    ],
    target_compatible_with = select({
        "@platforms//cpu:aarch64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

nasm_cc_test(
    name = "preincludes_test",
    size = "small",
    srcs = ["preincs_main.asm"],
    preincs = [
        "includes_inc.asm",
    ],
    target_compatible_with = select({
        "@platforms//cpu:aarch64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

nasm_cc_test(
    name = "includes_path_test",
    size = "small",
    srcs = ["includes_main.asm"],
    hdrs = ["includes/includes_inc.asm"],
    includes = ["includes"],
    target_compatible_with = select({
        "@platforms//cpu:aarch64": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

# Generated sources and headers exercise include paths within the output tree.
copy_file(
    name = "generated_main",
    src = "includes_main.asm",
    out = "generated/includes_main.asm",
)

copy_file(
    name = "generated_inc",
    src = "includes_inc.asm",
    out = "generated/includes/includes_inc.asm",
)

nasm_cc_test(
    name = "generated_includes_path_test",
    size = "small",
    srcs = [":generated_main"],
    hdrs = [":generated_inc"],
    includes = ["generated/includes"],
)

copy_file(
    name = "generated_sibling_main",
    src = "includes_main.asm",
    out = "generated/sibling/includes_main.asm",
)

copy_file(
    name = "generated_sibling_inc",
    src = "includes_inc.asm",
    out = "generated/sibling/includes_inc.asm",
)

nasm_cc_test(
    name = "generated_sibling_includes_test",
    size = "small",
    srcs = [":generated_sibling_main"],
    hdrs = [":generated_sibling_inc"],
)
